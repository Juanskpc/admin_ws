# ===============================================
# ESCALAPP - Backend Environment Variables
# ===============================================
# Copy this file to .env and adjust values for your environment

# ======== SERVIDOR ========
PORT=3000
NODE_ENV=development

# ======== BASE DE DATOS ========
# ⚠️ REGLA: en desarrollo se trabaja SIEMPRE contra una base de DESARROLLO.
#
# NUNCA apuntes esto a produccion, ni "un momento para mirar algo": NODE_ENV
# sigue valiendo 'development' y cualquier `npm run dev`, migracion, test o
# script de scripts/ escribe directamente en los datos del cliente.
#
# Y SOBRE TODO EN ESCALAPP INTELLIGENCE: ese trabajo CREA esquemas y tablas
# (platform, intelligence), hace backfills y escribe en un Ledger particionado.
# No es codigo que consulta, es codigo que cambia la forma de la base.
#
# Hay DOS bases de desarrollo validas. El PUERTO es lo unico que las distingue
# (nombre y usuario son identicos en las dos):
#
#   5432 -> LOCAL, en tu PC.        Para tests (npx jest) y experimentos.
#   5433 -> COMPARTIDA, en el VPS.  Para trabajo de Intelligence en equipo.
#           Requiere tunel: ssh -f -N -o ExitOnForwardFailure=yes \
#                               -L 5433:localhost:5432 escalapp
#           Password en el VPS: /home/escalapp/.dbpass_dev
#           NO lanzar `npx jest` contra ella: los dos devs se pisan.
#
# Comprobar antes de ejecutar nada:  grep -E '^DB_(HOST|PORT|NAME)=' .env
# Detalle completo en docs/desarrollo-local.md
DB_HOST=localhost
DB_PORT=5432
DB_NAME=escalapp_dev
DB_USER=escalapp_dev
DB_PASS=your_local_db_password_here
DB_SSL=false

# ======== JWT ========
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# ======== CORS CONFIGURATION ========
# DEVELOPMENT: Múltiples orígenes locales
# CORS_ORIGIN=http://localhost:4002,http://localhost:4003,http://localhost:6002
#
# PRODUCTION: Solo el dominio principal (todas las apps están bajo escalapp.cloud)
CORS_ORIGIN=https://escalapp.cloud

# ======== RATE LIMITING ========
# Desactivado por defecto tras la migración al VPS único (Vultr): detrás de
# Nginx el conteo por IP agrupaba a todos los clientes en un solo cubo y
# bloqueaba logins legítimos con "Demasiadas peticiones".
# Pendiente rediseñarlo (clave por usuario/negocio + almacén compartido).
# RATE_LIMIT_ENABLED=true

# ======== FRONTEND URLs (para redirecciones en correos, etc.) ========
# DEVELOPMENT
# FRONTEND_URL=http://localhost:4002
#
# PRODUCTION
FRONTEND_URL=https://escalapp.cloud

# ======== CORREO ELECTRÓNICO (SMTP) ========
# En desarrollo, si no se configuran MAIL_USER/MAIL_PASS,
# el OTP se imprime en consola sin enviar correo real.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=escalappsystem@gmail.com
MAIL_PASS=your_app_password_here

# ======== WHATSAPP ========
# Número de soporte en formato internacional (Colombia: 57 + 10 dígitos)
WHATSAPP_NUMBER=573114682492

# ======== AUTORIZACION MULTI-INQUILINO (ADR-002, ADR-010) ========
# observacion (por defecto) → audita las violaciones pero NO bloquea.
# bloqueo                   → responde 403 al acceder a un negocio ajeno.
#
# NO despliegues directamente en 'bloqueo': rechazaria peticiones que hoy
# funcionan y no sabemos cuales son. Procedimiento obligatorio:
#   1. Desplegar en 'observacion'.
#   2. Medir una semana: panel Admin → Auditoría → Eventos, modulo 'authz'.
#      (o: SELECT * FROM auditoria.audit_evento WHERE modulo='authz')
#   3. Corregir lo que aparezca; cuando no haya violaciones legitimas,
#   4. AUTHZ_MODO=bloqueo.
# AUTHZ_MODO=observacion

# ======== OUTBOX DE EVENTOS DE DOMINIO (ADR-012) ========
# Todas opcionales; los valores mostrados son los de por defecto.
# El relay solo arranca si hay consumidores registrados. Hoy no hay ninguno
# (los primeros llegan en F4/F5), asi que queda inactivo por si solo.
# OUTBOX_RELAY_ENABLED=true      # 'false' lo apaga aunque haya consumidores
# OUTBOX_POLL_MS=5000            # cada cuanto sondea la tabla
# OUTBOX_BATCH=50                # eventos por lote
# OUTBOX_MAX_INTENTOS=6          # tras agotarlos: dead letter (estado 'fallido')
# OUTBOX_BACKOFF_MAX_SEG=3600    # techo del backoff exponencial

# ======== CAPACIDADES / FEATURES (ADR-021) ========
# Escotilla de DESARROLLO para encender features sin tocar el catalogo comercial.
# Lista separada por comas; hoy la unica feature es 'asistente_ia'.
#
# Se IGNORA cuando NODE_ENV=production, a proposito: una variable que pudiera
# regalar features de pago en produccion no es una escotilla de desarrollo,
# es un agujero de facturacion esperando a que alguien copie un .env.
#
# Aparte de esto, cada capacidad debe habilitarse por negocio:
#   node scripts/capacidad.js habilitar <capacidad> --negocio <id>
# Sin fila en platform.capacidad_habilitada, el Policy Gate deniega.
# FEATURES_FORZADAS=asistente_ia

# ======== CONVERSATION ENGINE (ADR-014) ========
# Espera tras el ultimo mensaje antes de abrir el turno. ADR-014 pide 2-4 s:
# varios mensajes seguidos son UN turno, porque asi escribe la gente. Subirlo
# agrupa mejor y responde mas tarde; bajarlo, al reves.
# CONVERSACION_DEBOUNCE_MS=2500
#
# Techo desde el PRIMER mensaje del grupo. Sin el, alguien que escribe sin parar
# reinicia la espera indefinidamente y el bot no contesta nunca.
# CONVERSACION_DEBOUNCE_MAX_MS=10000
#
# Turnos simultaneos, de conversaciones distintas. Cada uno retiene una conexion
# del pool mientras dura (el lock es pesimista) y el pool tiene 10: pasar de 4 es
# competir con el trafico HTTP del backend.
# CONVERSACION_CONCURRENCIA=4
#
# A partir de aqui, un turno en 'procesando' se da por muerto y sus mensajes se
# liberan para que otro turno los retome. Debe ser MAYOR que el turno mas lento
# imaginable: dar por colgado uno que sigue vivo ensucia las metricas del Ledger.
# CONVERSACION_TURNO_COLGADO_MIN=10
#
# Antiguedad maxima de un mensaje entrante sin turno. Ademas de evitar que
# resucite algo de hace semanas, poda particiones en la consulta mas frecuente.
# CONVERSACION_VENTANA_DIAS=7
#
# A partir de aqui un turno se considera lento y se le avisa a la persona que
# seguimos trabajando (en WhatsApp, el 'escribiendo...' nativo). El numero sale
# de medir produccion: el Nivel 1 resuelve en 58 ms (p90 105, peor caso 552) y el
# turno mas rapido que sube al modelo tarda 1735 ms. 800 cae en medio, asi que
# ningun turno determinista parpadea y todos los del modelo avisan. 0 lo apaga.
# CONVERSACION_AVISO_ACTIVIDAD_MS=800
#
# Cuanto vive una tarea a medias sin que nadie la toque. Pasado esto, el
# siguiente mensaje NO retoma el hilo: se avisa y se empieza de cero. Tres
# horas cubre 'me interrumpieron y vuelvo' y deja fuera 'al dia siguiente',
# que es el caso que lo destapo (2026-08-27: un hueco de 19h45 retomado como
# si nada). Techo duro: pasadas 24 h WhatsApp ya no deja contestar texto
# libre, asi que una vida mayor prometeria algo que el canal no cumple.
# La confirmacion de una mutacion NO usa esto: tiene su propio reloj de 10 min.
# CONVERSACION_TAREA_VIDA_MS=10800000

# ======== CANALES / WEBCHAT (ADR-016, ADR-017) ========
# Expone /intelligence por HTTP y arranca motor + entregador. APAGADO por defecto.
#
# Desde F8-C son DOS interruptores, y la separacion importa:
#
#   INTELLIGENCE_HTTP_ENABLED    — la superficie HTTP. La necesita el WEBHOOK DE WHATSAPP,
#                                  que SI esta autenticado (firma HMAC de Meta sobre el cuerpo
#                                  crudo). En produccion va en true.
#   INTELLIGENCE_WEBCHAT_ENABLED — SOLO el WebChat (widget + simulador de fallos). NO esta
#                                  autenticado: un cliente final anonimo lo usa y el Principal
#                                  de tipo `contacto` sigue reservado sin implementar. Hoy solo
#                                  lo protege la feature comercial del negocio (`asistente_ia`).
#                                  EN PRODUCCION SE DEJA APAGADO.
#
# Antes una sola bandera montaba las dos cosas, asi que conectar el numero de WhatsApp
# encendia de rebote un WebChat sin autenticar. Con esto separado ya no.
# Apagado, el WebChat no responde 403: NO EXISTE la ruta, ni el widget ni el simulador.
#
# La clave publica por negocio y los origenes permitidos siguen pendientes, para el dia en que
# el WebChat sea producto.
#
# Con AMBOS en true: widget de pruebas en http://localhost:3000/intelligence/webchat/
# INTELLIGENCE_HTTP_ENABLED=false
# INTELLIGENCE_WEBCHAT_ENABLED=false
#
# Entrega asincrona de los mensajes salientes. Es asincrona A PROPOSITO (ADR-016):
# si el canal devolviera la respuesta del bot en el mismo HTTP de la ingesta, los
# criterios de aceptacion del motor se volverian infalsificables.
# CANAL_ENTREGA_POLL_MS=1000
# CANAL_ENTREGA_LOTE=50
# CANAL_ENTREGA_MAX_INTENTOS=5      # agotados: dead letter (estado_entrega 'fallido')
# CANAL_ENTREGA_VENTANA_HORAS=24    # mas viejo que esto ya no se entrega
# CANAL_ENTREGA_BACKOFF_MAX_SEG=300 # techo de la espera entre reintentos (F8-B)
#
# ======== RECORDATORIOS PROACTIVOS (F8-B) ========
#
# Los mensajes que EMPIEZA el negocio. Fuera de la ventana de 24 h solo pueden salir como
# plantilla aprobada por Meta, y por eso el recordatorio se diseño como plantilla desde el
# principio (intelligence/core/plantillas.js).
#
# RECORDATORIO_POLL_MS=60000        # cada cuanto se miran los que vencen
# RECORDATORIO_LOTE=20
# RECORDATORIO_MAX_INTENTOS=3
# RECORDATORIO_TOLERANCIA_MIN=120   # mas tarde que esto NO se manda: llegaria a destiempo
# RECORDATORIO_CANAL=whatsapp       # por donde se le escribe a un telefono
# RECORDATORIO_CITA_HORAS_ANTES=24  # cuanta antelacion lleva el recordatorio de una cita
#
# ⚠️ La plantilla `recordatorio_cita` tiene que estar REGISTRADA Y APROBADA en Meta con el mismo
#    texto que hay en el catalogo, o los envios se rechazan. Registrarla es parte de F8-C.

# ======== NOTAS DE CONFIGURACIÓN ========
# [PRODUCTION DEPLOYMENT]
# 1. NODE_ENV debe ser 'production'
# 2. CORS_ORIGIN debe ser 'https://escalapp.cloud'
# 3. FRONTEND_URL debe ser 'https://escalapp.cloud'
# 4. JWT_SECRET debe ser una clave fuerte y segura
# 5. DB_PASS debe ser la contraseña real de producción
# 6. El .env de producción vive SOLO en el VPS (/var/www/admin_ws/.env) y se
#    edita por SSH. La base corre en esa misma máquina, en localhost.

# ── EscalApp Intelligence · Nivel 4 (F6, ADR-018) ────────────────────────────────────────
# El primer LLM del sistema, y SOLO de lectura: no ve ninguna capacidad de mutación.
#
# Sin ninguna clave, la escalera se queda en el Nivel 1 determinista y todo sigue funcionando
# a $0.00 por turno. No es un fallo: el LLM es una capacidad opcional (ADR-005).
#
# Hay dos proveedores montados A PROPOSITO y de forma transitoria: la única manera honesta de
# elegir uno es medir los dos con las mismas conversaciones. Cuando la medición decida, el que
# pierda se borra. ADR-018 quiere UNO en operación, no dos mantenidos a medias.
#
#   node scripts/evaluar.js respuestas --negocio 1 --comparar gpt-5.6-luna,gpt-5.6-terra

# Pega aquí tu clave. Basta con una: el proveedor se deduce de la que esté puesta.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Modelo del Nivel 4. Su proveedor se deduce del modelo, asi que normalmente basta con esto.
#   OpenAI:    gpt-5.6-luna (barato)  gpt-5.6-terra (medio)  gpt-5.6-sol (caro)  gpt-4o
#   Anthropic: claude-opus-5  claude-opus-4-8  claude-haiku-4-5
# Si se omite, se usa el modelo por defecto del proveedor que tenga clave.
# LLM_MODELO=gpt-5.6-terra

# Solo hace falta si tienes las DOS claves puestas y quieres forzar cual se usa.
# Si contradice a LLM_MODELO, el arranque falla en vez de elegir en silencio.
# LLM_PROVEEDOR=openai

# Apaga el Nivel 4 aunque haya credencial. Util para medir el Nivel 1 en aislamiento.
# LLM_HABILITADO=true

# Esfuerzo del modelo: low | medium | high. El punto de partida es `low` y se afina con el
# arnes, que mide acierto, costo y latencia — elegirlo a ojo es lo que el arnes evita.
# LLM_ESFUERZO=low

# Cortacircuitos por turno. Un agente que no converge es el modo de fallo mas caro y mas
# silencioso que existe: no hay excepcion, hay factura.
# LLM_MAX_VUELTAS=4
# LLM_MAX_CENTAVOS_TURNO=5
# LLM_MAX_TOKENS=1024
# LLM_HISTORIAL=20
#
# ⚠️ EN PRODUCCION NO SE PONE NINGUNA CLAVE TODAVIA. El WebChat aun no autentica a nadie
#    (ver ESTADO-Y-CONTINUACION §6, decision 9): con el modelo encendido sobre un canal
#    abierto, cualquiera que encuentre la URL gasta tus tokens.

# ============================================
# Canal de WhatsApp (F8-A) — apagado sin las cinco
# ============================================
# El canal solo funciona con las CINCO puestas. Es deliberado: medio canal configurado recibe
# mensajes y no contesta, y desde fuera eso es un negocio que ignora a sus clientes. Al arrancar
# se imprime cual falta.
#
# WHATSAPP_APP_SECRET      — verifica la firma HMAC del webhook. SIN ESTO NO SE ACEPTA NADA:
#                            la firma es la unica autenticacion de este canal, y sin ella la URL
#                            del webhook es publica y cualquiera escribe en nombre de un cliente.
# WHATSAPP_VERIFY_TOKEN    — el saludo GET de Meta al suscribir el webhook. Lo eliges tu.
# WHATSAPP_PHONE_NUMBER_ID — el id del numero en la Cloud API (no el numero de telefono).
# WHATSAPP_TOKEN           — token de acceso para enviar. Es un secreto.
# WHATSAPP_NEGOCIO_ID      — a que id_negocio pertenece ese numero.
#
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_NEGOCIO_ID=
#
# Opcionales:
# WHATSAPP_API_VERSION=v21.0        # cambiar de version es cambiar de contrato
# WHATSAPP_API_URL=https://graph.facebook.com
# WHATSAPP_TIMEOUT_MS=8000          # Meta nos da 10 s en su webhook; no podemos colgarnos mas
# WHATSAPP_VENTANA_HORAS=24         # la ventana de servicio de Meta. Solo se toca para probar
#
# Solo para diagnostico (NO la lee el canal, solo scripts/whatsapp_diagnostico.js):
# WHATSAPP_WABA_ID=                 # id de la cuenta de WhatsApp Business. Sirve para preguntarle
#                                   # a la Graph API que numeros y plantillas hay de verdad, cuando
#                                   # el panel web de Meta dice otra cosa.
#
# ⚠️ UN SOLO NUMERO. La traduccion numero → negocio vive en variables de entorno
#    (intelligence/channels/whatsapp/config.js). El segundo inquilino necesita una tabla y una
#    decision sobre donde viven los tokens; hasta entonces esto es de un cliente.
# ⚠️ El webhook necesita el CUERPO CRUDO, asi que se monta antes del parser global en app.js.
#    Si algun dia el canal empieza a rechazar todo con FIRMA_NO_COINCIDE, mira ese orden primero.
